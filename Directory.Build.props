<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FunckyImplicitUsings>enable</FunckyImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>SA1201</NoWarn>
  </PropertyGroup>

  <!-- Audit direct and transitive packages; a high (NU1903) or critical (NU1904) advisory fails the
       build (locally and in CI), low/moderate ones stay warnings. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polyadic.CodeStyle" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
</Project>